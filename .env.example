# FARLOOM — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env or real API keys.

# -----------------------------------------------------------------------
# Provider selection
# -----------------------------------------------------------------------
# "fake"   — fully offline, deterministic (default). No API key needed.
#            Retrieval, graph, citations, and evaluation all work.
#            Answers are extractive (keyword-scored sentences).
# "gemini" — Google Gemini free-tier LLM for answer generation.
#            Requires GEMINI_API_KEY below.
# "openai" — OpenAI GPT + embeddings. Requires OPENAI_API_KEY below.
GRAPHRAG_PROVIDER=fake

# -----------------------------------------------------------------------
# Knowledge Graph Backend selection
# -----------------------------------------------------------------------
# "networkx" — in-memory NetworkX graph (default). Fully offline.
# "neo4j"    — persistent Neo4j or Neo4j AuraDB knowledge graph.
GRAPH_BACKEND=networkx

# -----------------------------------------------------------------------
# Neo4j / Neo4j AuraDB configuration (when GRAPH_BACKEND=neo4j)
# -----------------------------------------------------------------------
# Free Neo4j AuraDB instance: https://neo4j.com/cloud/platform/aura-graph-database/
# Format for AuraDB: neo4j+s://<instance-host>.databases.neo4j.io
# Format for local Neo4j: bolt://localhost:7687 or neo4j://localhost:7687
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CONNECTION_TIMEOUT=10.0


# -----------------------------------------------------------------------
# Data directory
# -----------------------------------------------------------------------
# Directory where the engine stores SQLite and ChromaDB index files.
# On free hosting (Render), the filesystem resets on restart.
# The bundled corpus is re-ingested automatically on startup if empty.
GRAPHRAG_DATA_DIR=artifacts/runtime

# -----------------------------------------------------------------------
# Retrieval confidence threshold (0..1)
# -----------------------------------------------------------------------
# Refuse to answer when normalized retrieval confidence is below this.
GRAPHRAG_MIN_CONFIDENCE=0.4

# -----------------------------------------------------------------------
# Google Gemini (free tier) — GRAPHRAG_PROVIDER=gemini
# -----------------------------------------------------------------------
# Get a free API key at https://aistudio.google.com/app/apikey
# Default model: gemini-2.0-flash-lite (free tier as of 2025)
GEMINI_API_KEY=
GRAPHRAG_GEMINI_MODEL=gemini-2.0-flash-lite

# -----------------------------------------------------------------------
# OpenAI — GRAPHRAG_PROVIDER=openai
# -----------------------------------------------------------------------
# Never commit a real key. Set via environment variable or hosting secrets.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GRAPHRAG_OPENAI_EMBED_MODEL=text-embedding-3-small
GRAPHRAG_OPENAI_CHAT_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------
# Server bind address (for `graphrag serve`)
# -----------------------------------------------------------------------
GRAPHRAG_HOST=127.0.0.1
GRAPHRAG_PORT=8000
